{
  "name": "diff-review",
  "displayName": "Diff Review with AI Agent",
  "description": "Inline code review comments — review AI-generated changes, submit feedback in batch to Copilot, Claude Code, or any AI agent, with git diff context",
  "version": "0.9.0",
  "publisher": "JinqiShen",
  "contributors": [
    {
      "name": "Stanimir Peev"
    }
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jinqishen0725/diff-review"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "build": "node esbuild.config.js ship",
    "build:ext": "node esbuild.config.js ext",
    "build:mcp": "node esbuild.config.js mcp",
    "build:launcher": "node esbuild.config.js launcher",
    "package": "echo y | npx vsce package --no-dependencies",
    "deploy": "npm run build && node scripts/local-deploy.js",
    "deploy:fast": "npm run build && node scripts/local-deploy.js --fast",
    "sandbox": "npm run build && node scripts/sandbox.js",
    "test": "node esbuild.config.js standalone && node --test test/*.test.js"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "code review",
    "comments",
    "copilot",
    "diff",
    "inline-comments",
    "claude",
    "mcp",
    "agent",
    "review",
    "git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "diffReview.createNote",
        "title": "Add Comment",
        "icon": "$(check)"
      },
      {
        "command": "diffReview.reply",
        "title": "Reply",
        "icon": "$(reply)"
      },
      {
        "command": "diffReview.editComment",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "diffReview.saveEdit",
        "title": "Save",
        "icon": "$(check)"
      },
      {
        "command": "diffReview.cancelEdit",
        "title": "Cancel",
        "icon": "$(close)"
      },
      {
        "command": "diffReview.deleteNote",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "diffReview.deleteThread",
        "title": "Delete Thread",
        "icon": "$(trash)"
      },
      {
        "command": "diffReview.sendThread",
        "title": "Send to Copilot",
        "icon": "$(send)"
      },
      {
        "command": "diffReview.resolve",
        "title": "Resolve",
        "icon": "$(check-all)"
      },
      {
        "command": "diffReview.unresolve",
        "title": "Reopen",
        "icon": "$(debug-restart)"
      },
      {
        "command": "diffReview.fixDriftedLocation",
        "title": "Fix Location…",
        "category": "Diff Review",
        "icon": "$(target)"
      },
      {
        "command": "diffReview.showMcpInfo",
        "title": "Diff Review: Show MCP Server Info",
        "icon": "$(server)"
      },
      {
        "command": "diffReview.registerMcpServer",
        "title": "Diff Review: Register MCP Server with a Coding Agent",
        "icon": "$(plug)"
      },
      {
        "command": "diffReview.installAgentCommands",
        "title": "Diff Review: Install the Diff Review Agent Commands",
        "icon": "$(terminal)"
      },
      {
        "command": "diffReview.showPanel",
        "title": "Diff Review: Show Comments Panel",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "diffReview.submitAll",
        "title": "Diff Review: Submit All to Copilot",
        "icon": "$(send)"
      },
      {
        "command": "diffReview.resolveAll",
        "title": "Diff Review: Resolve All",
        "icon": "$(check-all)"
      },
      {
        "command": "diffReview.deleteResolved",
        "title": "Diff Review: Delete All Resolved",
        "icon": "$(trash)"
      },
      {
        "command": "diffReview.clearAll",
        "title": "Diff Review: Clear All Comments",
        "icon": "$(clear-all)"
      },
      {
        "command": "diffReview.copyThread",
        "title": "Copy to Clipboard",
        "icon": "$(clippy)"
      },
      {
        "command": "diffReview.copyAll",
        "title": "Diff Review: Copy All to Clipboard",
        "icon": "$(clippy)"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "diffReview.createNote",
          "group": "inline",
          "when": "commentController == diffReview && commentThreadIsEmpty"
        },
        {
          "command": "diffReview.reply",
          "group": "inline",
          "when": "commentController == diffReview && !commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "diffReview.editComment",
          "group": "inline@1",
          "when": "commentController == diffReview && comment == userComment"
        },
        {
          "command": "diffReview.deleteNote",
          "group": "inline@2",
          "when": "commentController == diffReview"
        }
      ],
      "comments/comment/context": [
        {
          "command": "diffReview.saveEdit",
          "group": "inline@1",
          "when": "commentController == diffReview"
        },
        {
          "command": "diffReview.cancelEdit",
          "group": "inline@2",
          "when": "commentController == diffReview"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "diffReview.sendThread",
          "group": "inline@1",
          "when": "commentController == diffReview && !commentThreadIsEmpty"
        },
        {
          "command": "diffReview.copyThread",
          "group": "inline@2",
          "when": "commentController == diffReview && !commentThreadIsEmpty"
        },
        {
          "command": "diffReview.resolve",
          "group": "inline@2",
          "when": "commentController == diffReview && (commentThread == open || commentThread == drifted-open)"
        },
        {
          "command": "diffReview.unresolve",
          "group": "inline@2",
          "when": "commentController == diffReview && (commentThread == resolved || commentThread == drifted-resolved)"
        },
        {
          "command": "diffReview.fixDriftedLocation",
          "when": "commentController == diffReview && (commentThread == drifted-open || commentThread == drifted-resolved)",
          "group": "inline@3"
        },
        {
          "command": "diffReview.deleteThread",
          "group": "inline@4",
          "when": "commentController == diffReview && !commentThreadIsEmpty"
        }
      ],
      "commandPalette": [
        {
          "command": "diffReview.fixDriftedLocation",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "key": "escape",
        "command": "-workbench.action.hideComment",
        "when": "commentEditorFocused"
      }
    ],
    "languageModelTools": [
      {
        "name": "diffReview_listComments",
        "displayName": "List Diff Review Comments",
        "toolReferenceName": "listDiffComments",
        "icon": "$(comment)",
        "modelDescription": "Lists all inline review comments with their IDs, file locations, status (open/resolved), and full thread text including user and agent replies. Use this to see what review feedback exists.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "diffReview_createComment",
        "displayName": "Create Diff Review Comment",
        "toolReferenceName": "createDiffComment",
        "icon": "$(comment-add)",
        "modelDescription": "Create a new inline review comment thread at a file/line, as if typed into the editor gutter. Use this to leave review feedback for another agent (or yourself) to address later.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "description": "Workspace-relative file path, e.g. \"src/foo.ts\""
            },
            "line": {
              "type": "number",
              "description": "1-based line number to attach the comment to"
            },
            "endLine": {
              "type": "number",
              "description": "1-based end line, for a multi-line range. Defaults to line."
            },
            "text": {
              "type": "string",
              "description": "The comment text"
            }
          },
          "required": [
            "path",
            "line",
            "text"
          ]
        }
      },
      {
        "name": "diffReview_replyToComment",
        "displayName": "Reply to Diff Review Comment",
        "toolReferenceName": "replyToDiffComment",
        "icon": "$(reply)",
        "modelDescription": "Reply to an existing inline review comment thread. Use this to respond to user feedback on code changes, explain your reasoning, or acknowledge a requested change. The reply appears as an agent message in the comment thread.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "commentId": {
              "type": "number",
              "description": "The ID number of the comment thread to reply to (from listComments output, e.g. #1, #2)"
            },
            "text": {
              "type": "string",
              "description": "The reply text to add to the thread"
            }
          },
          "required": [
            "commentId",
            "text"
          ]
        }
      },
      {
        "name": "diffReview_resolveComment",
        "displayName": "Resolve Diff Review Comment",
        "toolReferenceName": "resolveDiffComment",
        "icon": "$(check)",
        "modelDescription": "Mark an inline review comment as resolved/done. Use this after you have addressed the feedback in the comment — e.g., after making the requested code change.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "commentId": {
              "type": "number",
              "description": "The ID number of the comment thread to resolve"
            }
          },
          "required": [
            "commentId"
          ]
        }
      },
      {
        "name": "diffReview_deleteComment",
        "displayName": "Delete Diff Review Comment",
        "toolReferenceName": "deleteDiffComment",
        "icon": "$(trash)",
        "modelDescription": "Delete an inline review comment thread entirely. Use this only when explicitly asked to remove a comment.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "commentId": {
              "type": "number",
              "description": "The ID number of the comment thread to delete"
            }
          },
          "required": [
            "commentId"
          ]
        }
      }
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "jsonc-parser": "^3.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/vscode": "^1.93.0",
    "esbuild": "^0.20.0",
    "sharp": "^0.34.5",
    "typescript": "^5.0.0"
  }
}
